# Required for Linear boards (ticketSystem: "linear").
LINEAR_API_KEY=lin_api_YOUR_KEY_HERE

# Required for Jira boards (ticketSystem: "jira").
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=YOUR_JIRA_API_TOKEN_HERE

# Required for GitHub Projects boards (ticketSystem: "github-projects").
# Fine-grained PAT scoped to the configured repo + project, with permissions:
# Issues:write, Projects:read, Projects:write, Metadata:read.
# (Projects:write does NOT imply Projects:read for ProjectV2 — both are needed.)
GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE

