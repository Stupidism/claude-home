# Ignore everything by default
*

# Root exceptions
!.gitignore
!README.md
!CLAUDE.md
!WORKFLOW.md

# GitHub Actions workflows
!.github/
!.github/workflows/
!.github/workflows/**

# .claude config directory — subdirectory .gitignore handles runtime exclusions
!.claude/
!.claude/**

# presentations / slide decks
!ppt/
!ppt/**

# symphony automation
# NOTE: Because `!symphony/**` force-re-includes everything below, the nested
# symphony/.gitignore cannot override it. Runtime/local exclusions must live here.
!symphony/
!symphony/**
# Personal config is machine-specific and must not be committed
symphony/config/
symphony/config/**
# Runtime state written by the poller and other scripts
symphony/state/
symphony/logs/
symphony/node_modules/
symphony/*.pid
symphony/secrets.env
